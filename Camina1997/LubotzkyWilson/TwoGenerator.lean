module

public import Camina1997.LubotzkyWilson.Coordinates
public import Camina1997.LubotzkyWilson.Isolation
public import Camina1997.ProP.Products
public import Camina1997.ProP.Closure
public import Camina1997.ProP.ProductEmbedding

/-!
# The two-generator hull of a product of finite derived groups

The sparse coordinate functions isolate every one-coordinate commutator.
Closing the subgroup generated by the shift and the sparse function therefore
contains the entire product of the finite derived subgroups.

Reference: Lubotzky–Wilson (1984), pp. 398–399.
-/

@[expose] public section

open scoped commutatorElement

namespace Camina1997.LubotzkyWilson

open RegularWreathProduct

variable (F : ℕ → Type*) [∀ n, Group (F n)] [∀ n, Finite (F n)] (q : ℕ)

/-- The finite wreath product attached to one sparse block. -/
abbrev WreathFactor (n : ℕ) := F n ≀ᵣ Multiplicative (CyclicCoordinates F q n)

/-- The common acting generator in the product of wreath products. -/
noncomputable def shiftVector : ∀ n, WreathFactor F q n :=
  fun _ => cyclicShift _ 1

/-- The vector of sparse base functions. -/
noncomputable def sparseVector : ∀ n, WreathFactor F q n :=
  fun n => baseHom (sparseBase F q n)

/-- The copy of one finite group supported at the identity of its own wreath factor. -/
noncomputable def coordinateHom (n : ℕ) : F n →* ∀ m, WreathFactor F q m := by
  classical
  exact (MonoidHom.mulSingle (WreathFactor F q) n).comp (singleHom 1)

omit [∀ n, Finite (F n)] in
theorem coordinateHom_injective (n : ℕ) : Function.Injective (coordinateHom F q n) := by
  classical
  intro a b h
  have he := congrArg (fun f : ∀ m, WreathFactor F q m => (f n).left 1) h
  simpa [coordinateHom] using he

theorem sparseBase_support (n : ℕ) (z : CyclicCoordinates F q n)
    (hz : sparseBase F q n (Multiplicative.ofAdd z) ≠ 1) :
    ∃ a : ℕ, blockEnd F n < a ∧ a ≤ blockEnd F (n + 1) ∧
      z = (q : CyclicCoordinates F q n) ^ a := by
  simpa only [Nat.cast_pow] using sparseFunction_ne_one_imp F q n z hz

/-- Powers of the common shift have the specified cyclic translations in every factor. -/
theorem shifted_sparseVector_apply (i n : ℕ) :
    (shiftVector F q ^ (q ^ i) * sparseVector F q * (shiftVector F q ^ (q ^ i))⁻¹) n =
      cyclicShift _ ((q : CyclicCoordinates F q n) ^ i) * baseHom (sparseBase F q n) *
        (cyclicShift _ ((q : CyclicCoordinates F q n) ^ i))⁻¹ := by
  simp only [Pi.mul_apply, Pi.inv_apply, Pi.pow_apply, shiftVector, sparseVector,
    cyclicShift_one_pow, Nat.cast_pow]

/-- Two translated sparse vectors isolate exactly one finite-group commutator. -/
theorem isolated_coordinate_commutator (hq : 2 < q) (n : ℕ) (a b : F n) :
    ⁅shiftVector F q ^ (q ^ elementIndex F n a) * sparseVector F q *
        (shiftVector F q ^ (q ^ elementIndex F n a))⁻¹,
      shiftVector F q ^ (q ^ elementIndex F n b) * sparseVector F q *
        (shiftVector F q ^ (q ^ elementIndex F n b))⁻¹⁆ =
      coordinateHom F q n ⁅a, b⁆ := by
  classical
  funext m
  change ⁅(shiftVector F q ^ (q ^ elementIndex F n a) * sparseVector F q *
        (shiftVector F q ^ (q ^ elementIndex F n a))⁻¹) m,
      (shiftVector F q ^ (q ^ elementIndex F n b) * sparseVector F q *
        (shiftVector F q ^ (q ^ elementIndex F n b))⁻¹) m⁆ = _
  rw [shifted_sparseVector_apply, shifted_sparseVector_apply]
  by_cases hmn : m = n
  · subst m
    rw [cyclicShift_commutator_eq_single hq _ (sparseBase_support F q n)]
    simp only [coordinateHom, MonoidHom.comp_apply, MonoidHom.mulSingle_apply,
      Pi.mulSingle_eq_same, sparseBase_ofAdd]
    rw [← Nat.cast_pow, ← Nat.cast_pow, sparseFunction_elementIndex F (by omega),
      sparseFunction_elementIndex F (by omega)]
  · rw [cyclicShift_commutator_eq_one_of_not_mem hq _ (sparseBase_support F q m)]
    · simp [coordinateHom, commutatorElement_def, hmn]
    · intro hi
      exact hmn (block_eq_of_elementIndex_mem F a hi.1 hi.2.1)

/-- Every one-coordinate derived element belongs to the subgroup generated by two vectors. -/
theorem coordinate_commutator_subgroup (hq : 2 < q) (n : ℕ) :
    commutator (F n) ≤
      (Subgroup.closure {shiftVector F q, sparseVector F q}).comap (coordinateHom F q n) := by
  rw [commutator_eq_closure]
  rw [Subgroup.closure_le]
  rintro _ ⟨a, b, rfl⟩
  change coordinateHom F q n ⁅a, b⁆ ∈ Subgroup.closure {shiftVector F q, sparseVector F q}
  rw [← isolated_coordinate_commutator F q hq n a b]
  let S := Subgroup.closure {shiftVector F q, sparseVector F q}
  have ht : shiftVector F q ∈ S := Subgroup.subset_closure (by simp)
  have hθ : sparseVector F q ∈ S := Subgroup.subset_closure (by simp)
  have hc (i : ℕ) : shiftVector F q ^ (q ^ i) * sparseVector F q *
      (shiftVector F q ^ (q ^ i))⁻¹ ∈ S :=
    S.mul_mem (S.mul_mem (S.pow_mem ht _) hθ) (S.inv_mem (S.pow_mem ht _))
  exact S.mul_mem (S.mul_mem (S.mul_mem (hc _) (hc _)) (S.inv_mem (hc _)))
    (S.inv_mem (hc _))

end Camina1997.LubotzkyWilson
