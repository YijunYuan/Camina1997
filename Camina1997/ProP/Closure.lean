module

public import Camina1997.ProP.FiniteGeneration

/-!
# Finite generation of subgroup closures

The topological closure of the subgroup generated by finitely many elements
is topologically finitely generated by those same elements.
-/

@[expose] public section

namespace Camina1997

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- The original generators remain dense generators inside their closed generated subgroup. -/
theorem dense_generators_topologicalClosure (s : Set G) :
    Dense (Subgroup.closure
      ((Subtype.val : (Subgroup.closure s).topologicalClosure → G) ⁻¹' s) :
      Set (Subgroup.closure s).topologicalClosure) := by
  let H := (Subgroup.closure s).topologicalClosure
  let t : Set H := (Subtype.val : H → G) ⁻¹' s
  have himage : (Subtype.val : H → G) '' t = s := by
    apply Set.image_preimage_eq_of_subset
    intro g hg
    exact ⟨⟨g, (Subgroup.closure s).le_topologicalClosure (Subgroup.subset_closure hg)⟩, rfl⟩
  have hclosure : (Subtype.val : H → G) '' (Subgroup.closure t : Set H) =
      (Subgroup.closure s : Set G) := by
    change ((Subgroup.closure t).map H.subtype : Set G) = _
    rw [MonoidHom.map_closure]
    exact congrArg (fun u : Set G => (Subgroup.closure u : Set G)) himage
  apply Subtype.dense_iff.mpr
  change (H : Set G) ⊆ closure ((Subtype.val : H → G) '' (Subgroup.closure t : Set H))
  rw [hclosure]
  exact Set.Subset.rfl

/-- Closing a subgroup generated by finitely many elements gives a topologically finitely
generated group. -/
theorem topologicallyFG_topologicalClosure {s : Set G} (hs : s.Finite) :
    TopologicallyFG (Subgroup.closure s).topologicalClosure := by
  refine ⟨(Subtype.val : (Subgroup.closure s).topologicalClosure → G) ⁻¹' s,
    hs.preimage Subtype.val_injective.injOn, dense_generators_topologicalClosure s⟩

end Camina1997
